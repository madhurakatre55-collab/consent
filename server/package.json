{
  "name": "consent-server",
  "version": "1.0.0",
  "description": "Backend server for Consent - PayPal AI Hackathon",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
